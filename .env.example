# ---------------------------------------------------------------------------
# docker compose configuration. Copy to `.env` and fill in the three REQUIRED
# secrets — compose refuses to start without them, on purpose. Never commit `.env`.
#
# One way to generate all three at once (Linux, macOS, WSL, Git Bash):
#
#   printf 'JWT_ACCESS_SECRET=%s\nJWT_REFRESH_SECRET=%s\nFIELD_ENCRYPTION_KEY=%s\n' \
#     "$(openssl rand -base64 48)" "$(openssl rand -base64 48)" "$(openssl rand -base64 32)" > .env
# ---------------------------------------------------------------------------

# ---- Secrets (REQUIRED) ----
# Sign access and refresh tokens. At least 32 characters each, and different.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Encrypts second-factor secrets at rest: base64 of exactly 32 bytes.
# Losing it makes every enrolled second factor unreadable. Back it up.
FIELD_ENCRYPTION_KEY=

# ---- Demo installation (NOT for a real one) ----
# Uncomment only to evaluate with the fictional demo chain. Its accounts have published
# passwords: the demo seed refuses to run without this, the API refuses their sign-in,
# and a production API refuses to start while one is enabled (README, "Try it").
# ERP_DEMO=1

# ---- Optional (defaults shown) ----
# POSTGRES_PASSWORD=erp-local       # only reachable inside the compose network
# ERP_API_PORT=3100
# ERP_WEB_PORT=8180
# CORS_ORIGINS=http://localhost:8180
# LOG_LEVEL=INFO
# LOG_FORMAT=default
