// Units and the item master — owned by the items module (#5, ADR-0005, ADR-0019).

/// A unit of measure. A fixed catalogue in v1, written by migration.
model Unit {
  code     String @id
  nameTh   String @map("name_th")
  nameEn   String @map("name_en")
  /// Decimal places a quantity in this unit carries: kg 3 (to the gram), piece 0 (ADR-0019).
  decimals Int

  baseOf     Item[]              @relation("ItemBaseUnit")
  purchaseOf ItemPurchaseUnit[]
  orderedIn  PurchaseOrderLine[]
  receivedIn GoodsReceiptLine[]

  @@map("units")
}

/// Anything the company stocks (docs/GLOSSARY.md). Deactivated, never deleted.
model Item {
  id                          String   @id @default(uuid()) @db.Uuid
  /// Unique and stable: set once, never changed.
  code                        String   @unique
  nameTh                      String   @map("name_th")
  nameEn                      String   @map("name_en")
  baseUnitCode                String   @map("base_unit_code")
  baseUnit                    Unit     @relation("ItemBaseUnit", fields: [baseUnitCode], references: [code])
  variableWeight              Boolean  @default(false) @map("variable_weight")
  shelfLifeDays               Int      @map("shelf_life_days")
  /// Receiving tolerances (#11, ADR-0007): the largest difference between counted and expected
  /// quantity, in percent, and the warmest the goods may arrive, in °C. Null means no check.
  /// Configuration the receiving dock needs, not master data a POS mirrors: changing them does
  /// not take a master data version.
  receivingMaxVariancePercent Decimal? @map("receiving_max_variance_percent") @db.Decimal(5, 2)
  receivingMaxTemperature     Decimal? @map("receiving_max_temperature") @db.Decimal(3, 1)
  /// Requisition unit (#15, ADR-0029): base units the plant packs and sends the item in (a tray of
  /// 12 pieces is 12). Suggestions round up to it, requests are whole numbers of it. Null means
  /// none. Configuration, like the tolerances: no master data version.
  requisitionUnit             Decimal? @map("requisition_unit") @db.Decimal(18, 3)
  active                      Boolean  @default(true)
  /// The master data version of this item's latest change.
  version                     BigInt
  createdAt                   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  purchaseUnits        ItemPurchaseUnit[]
  lots                 Lot[]
  ledgerEntries        LedgerEntry[]
  stockBalances        StockBalance[]
  openingBalanceLines  OpeningBalanceLine[]
  adjustmentLines      StockAdjustmentLine[]
  purchaseOrderLines   PurchaseOrderLine[]
  recipeLines          RecipeLine[]
  goodsReceiptLines    GoodsReceiptLine[]
  supplierReturnLines  SupplierReturnLine[]
  productionBomLines   ProductionBomLine[]
  productionInputs     ProductionOrderInput[]
  productionOutputs    ProductionOrderOutput[]
  transferLines        TransferLine[]
  transferReceiptLines TransferReceiptLine[]
  parLevels            ParLevel[]
  requisitionLines     RequisitionLine[]

  @@map("items")
}

/// A unit the item is bought in, and how many base units one of it is (1 case = 20 kg).
model ItemPurchaseUnit {
  itemId   String  @map("item_id") @db.Uuid
  item     Item    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  unitCode String  @map("unit_code")
  unit     Unit    @relation(fields: [unitCode], references: [code])
  factor   Decimal @db.Decimal(18, 6)

  @@id([itemId, unitCode])
  @@map("item_purchase_units")
}
