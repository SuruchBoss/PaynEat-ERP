# ---------------------------------------------------------------------------
# PaynEat ERP — backend environment for running on your own machine.
# Copy to `.env` and adjust. Never commit the real file.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000
API_PREFIX=api
# Comma-separated list. Must be explicit in production — no wildcards.
CORS_ORIGINS=http://localhost:5173

# ---- Database ----
DATABASE_URL=postgresql://erp:erp@localhost:5432/payneat_erp?schema=public

# The end-to-end suite wipes the database it runs against, so it refuses one whose
# name has no "test" in it. Point it at a throwaway database.
E2E_DATABASE_URL=postgresql://erp:erp@localhost:5432/payneat_erp_test?schema=public

# ---- Authentication (#4) ----
# Generate your own: `openssl rand -base64 48` for each JWT secret (at least 32
# characters, different from each other), `openssl rand -base64 32` for the key.
JWT_ACCESS_SECRET=change-me-to-a-long-random-access-secret
JWT_REFRESH_SECRET=change-me-to-a-different-long-refresh-secret
# base64 of exactly 32 bytes. Encrypts second-factor secrets; the demo seed needs it too.
FIELD_ENCRYPTION_KEY=
# JWT_ACCESS_TTL=900            # seconds
# JWT_REFRESH_TTL=604800        # seconds
# AUTH_MAX_FAILED_ATTEMPTS=5    # wrong passwords or codes before a lockout
# AUTH_LOCKOUT_MINUTES=15
# PASSWORD_MIN_LENGTH=12
# THROTTLE_LIMIT=120            # requests per THROTTLE_TTL seconds from one address
# AUTH_THROTTLE_LIMIT=10        # sign-in and second-factor requests per minute

# ---- Demo installation (#5) ----
# The demo seed's accounts have published passwords. The seed runs only with ERP_DEMO=1
# (and never under NODE_ENV=production), and the API lets them sign in only with it too.
# Uncomment to evaluate with the demo chain; never on a real installation.
# ERP_DEMO=1

# ---- Observability (docs/TELEMETRY.md v1.1) ----
# DEBUG | INFO | NOTICE | WARNING | ERROR | CRITICAL. Stack traces are logged only at DEBUG.
LOG_LEVEL=INFO
# `default` writes vendor-neutral JSON. `gcp` is for Google Cloud deployments only: it
# moves the labels and the trace to the keys Cloud Logging reads specially.
LOG_FORMAT=default
# With LOG_FORMAT=gcp, turns a W3C trace id into projects/<id>/traces/<trace>.
# GOOGLE_CLOUD_PROJECT=
# Prometheus /metrics is served on this port, never on the API port. Do not publish it.
METRICS_PORT=9464
